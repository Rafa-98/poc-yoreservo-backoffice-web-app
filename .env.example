# Copy this file to `.env.local` and fill in the values you need.

# Base URL of the YoReservo backend (poc-yoreservo-backend-service).
# Server-only (no NEXT_PUBLIC_ prefix): the browser never talks to the backend directly.
# Defaults to http://localhost:4000 when empty.
API_BASE_URL=http://localhost:4000

# IANA time zone in which "today" and "already started" are judged by the operational screens
# (agenda, check-in, dashboard KPIs). It MUST match the backend's APP_TIMEZONE.
# Defaults to America/Caracas when empty.
BUSINESS_TIME_ZONE=America/Caracas

# Origin that serves the images the backend returns (activity, venue and space imageUrl).
# next/image only optimizes remote images from this origin (see next.config.ts).
# Locally the demo images are served by the client web app (poc-yoreservo-client-web-app) from its /public.
# Defaults to http://localhost:3000.
ASSETS_BASE_URL=http://localhost:3000
